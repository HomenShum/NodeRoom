+    if (!room) return { room: null, job: null, frames: [], operations: [] };
+    const jobs = await ctx.db.query("agentJobs").withIndex("by_room", (q) => q.eq("roomId", room._id)).order("desc").take(1);
+    const job = jobs[0];
+    if (!job) {
