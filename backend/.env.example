# GMI MaaS (OpenAI-compatible)
GMI_MAAS_BASE_URL=https://api.gmi-serving.com/v1
GMI_MAAS_API_KEY=...
VISION_MODEL=nvidia/nemotron-3-nano-omni
ORCHESTRATOR_MODEL=nvidia/nemotron-3-ultra
FALLBACK_VISION_MODEL=google/gemini-3-flash-preview

# GPU model workers (external HTTP endpoints)
# Hunyuan3D: GMI Cloud serverless — endpoint is optional (defaults to GMI Cloud), only API key required
HUNYUAN3D_ENDPOINT=https://console.gmicloud.ai/api/v1/ie/requestqueue/apikey/requests
HUNYUAN3D_API_KEY=
TRELLIS_ENDPOINT=
TRELLIS_API_KEY=
PARTPACKER_ENDPOINT=
PARTPACKER_API_KEY=
PARTCRAFTER_ENDPOINT=
PARTCRAFTER_API_KEY=

# Web search
TAVILY_API_KEY=

# Observability
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=photo-to-3d-proof-agent

# Storage / state
ARTIFACT_BUCKET=
ARTIFACT_PUBLIC_BASE_URL=
REDIS_URL=

# Runtime
MAX_GENERATION_ATTEMPTS=2
ENABLE_PART_AWARE_LANES=false
