{
  "name": "@homenshum/nodeagent-engines",
  "version": "0.1.0",
  "description": "Native-SDK execution engines (Claude Agent SDK, Codex app-server, OpenAI Agents, Google ADK, universal AI SDK loop) behind one Node run contract, plus the Node agent worker (durable run store, SSE events, tool catalog, skill lifecycle, goals).",
  "type": "module",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=22.13"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nodeagent-worker": "./dist/server/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./react/styles.css": "./dist/react/styles.css",
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js"
    }
  },
  "files": [
    "dist",
    "fixtures",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/react/styles.css','dist/react/styles.css')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx \"test/**/*.test.ts\"",
    "worker": "tsx src/server/bin.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.91",
    "@ai-sdk/google": "4.0.107",
    "@ai-sdk/openai": "4.0.104",
    "@anthropic-ai/claude-agent-sdk": "0.3.312",
    "@google/adk": "2.4.0",
    "@google/genai": "2.32.0",
    "@openai/agents": "0.21.0",
    "@openai/codex": "0.165.0",
    "ai": "6.0.280",
    "lucide-react": "0.515.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "sideEffects": [
    "*.css"
  ]
}
