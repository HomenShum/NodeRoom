{
  "schema": 1,
  "id": "finauditing",
  "source": {
    "name": "FinAuditing",
    "paper": "https://arxiv.org/abs/2510.08886",
    "tasks": [
      "FinSM",
      "FinRE",
      "FinMR"
    ]
  },
  "taskLoader": "proofloop/benchmarks/finauditing/load-tasks.ts",
  "seedInputsThroughUi": true,
  "browserScenario": "proofloop/benchmarks/finauditing/browser-scenario.spec.ts",
  "verifierCommand": "proofloop/benchmarks/finauditing/verify.ts",
  "officialScorer": {
    "name": "FinAuditing official scorer",
    "required": true,
    "unavailableReason": "FinAuditing live UI adapter and official scorer are registered as required but not implemented in this repo yet."
  },
  "expectedArtifacts": [
    "live-user-contract.json",
    "node-trace-v2.json",
    "node-eval.json",
    "scorecard.md",
    "cost-ledger.json",
    "verifier-receipt.json",
    "official-scorer-receipt.json",
    "cockpit-events.jsonl",
    "cockpit-snapshot.json",
    "visual-proof",
    "exported-files-reopen-proof.json"
  ],
  "scoringMode": "hybrid",
  "scoreFields": [
    "productPathCompletion",
    "officialSemanticScore"
  ],
  "liveUserCommand": "npm run proofloop -- run finauditing --prod --user-emulation strict --cockpit"
}
